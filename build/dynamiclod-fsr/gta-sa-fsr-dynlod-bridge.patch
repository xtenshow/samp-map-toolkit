+// C ABI consumed by DynamicLOD's LuaJIT FFI. These functions update atomic
+// runtime settings only. D3D9 resources are recreated by the renderer hook.
+#[unsafe(no_mangle)]
+pub extern "system" fn dynlod_fsr_api_version() -> u32 {
+    if DYNLOD_FSR_API_READY.load(Ordering::Acquire) == 1 { 1 } else { 0 }
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn dynlod_fsr_is_enabled() -> i32 {
+    if DYNLOD_FSR_API_READY.load(Ordering::Acquire) == 1 && config::get().enabled { 1 } else { 0 }
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn dynlod_fsr_get_render_scale() -> f32 {
+    config::get().effective_render_scale()
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn dynlod_fsr_get_raw_render_scale() -> f32 {
+    config::get().render_scale
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn dynlod_fsr_get_quality_preset() -> i32 {
+    config::get().quality as i32
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn dynlod_fsr_set_render_scale(scale: f32) -> i32 {
+    if !scale.is_finite() || !(0.10..=1.00).contains(&scale) { return -1; }
+    if DYNLOD_FSR_API_READY.load(Ordering::Acquire) != 1 || !config::get().enabled { return -2; }
+    if let Err(error) = config::set_render_scale(scale, false) {
+        config::log(&format!("DynamicLOD set scale failed: {error}"));
+        return -3;
+    }
+    if let Err(error) = config::set_quality(config::QualityPreset::Custom, false) {
+        config::log(&format!("DynamicLOD set custom quality failed: {error}"));
+        return -4;
+    }
+    renderer::request_quality_rebuild();
+    1
+}
+
+#[unsafe(no_mangle)]
+pub extern "system" fn dynlod_fsr_restore_render_settings(quality_id: i32, raw_scale: f32) -> i32 {
+    if !raw_scale.is_finite() || !(0.10..=1.00).contains(&raw_scale) { return -1; }
+    if DYNLOD_FSR_API_READY.load(Ordering::Acquire) != 1 || !config::get().enabled { return -2; }
+
+    let quality = match quality_id {
+        0 => config::QualityPreset::UltraQuality,
+        1 => config::QualityPreset::Quality,
+        2 => config::QualityPreset::Balanced,
+        3 => config::QualityPreset::Performance,
+        4 => config::QualityPreset::Custom,
+        _ => return -3,
+    };
+    if let Err(error) = config::set_render_scale(raw_scale, false) {
+        config::log(&format!("DynamicLOD restore scale failed: {error}"));
+        return -4;
+    }
+    if let Err(error) = config::set_quality(quality, false) {
+        config::log(&format!("DynamicLOD restore quality failed: {error}"));
+        return -5;
+    }
+    renderer::request_quality_rebuild();
+    1
+}
+
